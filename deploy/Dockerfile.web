# syntax=docker/dockerfile:1
#
# Web image: builds the Vite/React SPA, serves it with nginx, and reverse-proxies
# /api/* to the agent backend and the virtual-desktop Chromium CDP (tab bridge).
# This replaces the Vite dev-server proxy (vite.config.ts) for production.

# ---- Build stage ----
FROM node:22-bookworm-slim AS build
WORKDIR /app

# Install deps against the committed lockfile for reproducible builds.
COPY package.json package-lock.json ./
RUN npm ci

# Copy only what the production build needs (keeps context small & cache-friendly).
COPY tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts index.html components.json ./
COPY src ./src
COPY public ./public

# Build-time frontend config. Vite inlines VITE_* into the bundle, so these must
# be present at build time (supplied via compose build.args / deploy/.env).
# Defaults keep auth disabled for a turnkey self-host; provide real Firebase
# values (and flip VITE_AUTH_DISABLED=false) to enable sign-in.
ARG VITE_AUTH_DISABLED=true
ARG VITE_AGENT_DESKTOP_URL=
ARG VITE_FIREBASE_API_KEY=
ARG VITE_FIREBASE_AUTH_DOMAIN=
ARG VITE_FIREBASE_PROJECT_ID=
ARG VITE_FIREBASE_STORAGE_BUCKET=
ARG VITE_FIREBASE_MESSAGING_SENDER_ID=
ARG VITE_FIREBASE_APP_ID=
ARG VITE_GOOGLE_OAUTH_CLIENT_ID=
ENV VITE_AUTH_DISABLED=$VITE_AUTH_DISABLED \
    VITE_AGENT_DESKTOP_URL=$VITE_AGENT_DESKTOP_URL \
    VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY \
    VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID \
    VITE_FIREBASE_STORAGE_BUCKET=$VITE_FIREBASE_STORAGE_BUCKET \
    VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID \
    VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID \
    VITE_GOOGLE_OAUTH_CLIENT_ID=$VITE_GOOGLE_OAUTH_CLIENT_ID

# `npm run build` == `tsc -b && vite build` -> emits ./dist
RUN npm run build

# ---- Runtime stage ----
FROM nginx:1.27-alpine AS runtime
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
