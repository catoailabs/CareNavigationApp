###############################################################################
# Care Navigation — self-hosted stack configuration.
# Copy this file to deploy/.env and fill in the values. NEVER commit the real .env.
#   cd deploy && cp .env.example .env
###############################################################################

# ---- Public origin (REQUIRED) ----------------------------------------------
# Scheme + host[:port] the app is served from. Drives the agent's production
# CORS allow-list — the backend refuses to boot in production without it.
# Examples:  https://care.example.com   |   http://203.0.113.10:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Host port the web UI is published on (maps to the web container's :80).
WEB_PORT=8080

# ---- Agent secrets (REQUIRED) ----------------------------------------------
XAI_API_KEY=
PERPLEXITY_API_KEY=
# Optional Strands overrides:
# STRANDS_MODEL_ID=
# STRANDS_AGENT_ID=

# ---- Authentication --------------------------------------------------------
# Turnkey default: auth disabled (single shared "dev-user"). For real multi-user
# sign-in, set both to false, fill the VITE_FIREBASE_* values below, and provide
# Firebase Admin credentials to the agent (see server/firebase_admin_support.py).
VITE_AUTH_DISABLED=true
FIREBASE_AUTH_DISABLED=true

# Firebase web config — only needed when VITE_AUTH_DISABLED=false (build-time).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional Google OAuth (Connect Google tools) — build-time.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# ---- Virtual desktop (the agent's browser) ---------------------------------
# In-app live-preview iframe origin. Set to the public URL where the desktop
# (DESKTOP_PORT) is reachable, e.g. https://desktop.example.com. Leave blank to
# fall back to http://localhost:3001 (only resolves on the host machine).
VITE_AGENT_DESKTOP_URL=

# Basic-auth credentials for the browser-accessible desktop. CHANGE THE PASSWORD.
DESKTOP_USER=ron
DESKTOP_PASSWORD=
DESKTOP_PORT=3001
DESKTOP_START_URL=https://www.google.com

# Desktop container user / timezone.
TZ=UTC
PUID=1000
PGID=1000
