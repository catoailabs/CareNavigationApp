# Generated runtime artifacts — regenerated by tools/guidelines/vector_store.py.
# guidelines_vector_store.faiss is 2.8 GB and guidelines_vector_store.records.jsonl
# is 504 MB; both exceed GitHub's 100 MB push limit.
data/runtime/
# Large generated vector-store checkpoint (>100 MB) under src/data/runtime.
src/data/runtime/*.checkpoint/

# Local dev tenant-environment store (per-uid, encrypted) and its auto-generated
# Fernet key. Never committed — contains local tenant data and the dev key.
/data/tenant_environments.dev.json
/data/tenant_environments.dev.json.key
/data/tenant_environments.dev.json.tmp
