# Vite dev-mode defaults (loaded only by `vite` / `npm run dev`, never by
# `vite build`). Committed on purpose: contains no secrets, only the local auth
# bypass toggle so the frontend and the agent (scripts/run-provider-agent.sh,
# which defaults FIREBASE_AUTH_DISABLED=true) agree without manual setup.
#
# In this mode getAuthClient() returns null, no Authorization header is sent,
# and the backend resolves requests to DEV_FALLBACK_UID ("dev-user").
#
# To run against real Firebase locally, create a git-ignored .env.local with:
#   VITE_AUTH_DISABLED=false
#   VITE_FIREBASE_API_KEY=...   (and the other VITE_FIREBASE_* values)
# and start the agent with FIREBASE_AUTH_DISABLED=false.
VITE_AUTH_DISABLED=true
